# Environment
NODE_ENV=development
PORT=4000

# Database
# Geliştirme ortamı için (Tauri runtime'da bu otomatik ayarlanır)
DATABASE_URL=file:./devamsizlik.db

# JWT
# JWT Secret — en az 32 karakter (Tauri runtime'da otomatik üretilir)
JWT_SECRET=development-only-secret-change-in-production
JWT_EXPIRES_IN=8h

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Upload
UPLOAD_DIR=./uploads

# Domain (used in WhatsApp link)
FRONTEND_DOMAIN=https://yourdomain.com

# CORS
CORS_ORIGIN=http://localhost:5173
