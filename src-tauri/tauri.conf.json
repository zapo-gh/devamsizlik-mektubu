{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OkulDesk",
  "version": "1.0.0",
  "identifier": "com.okuldesk.app",
  "build": {
    "frontendDist": "../backend/dist/public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:all"
  },
  "app": {
    "windows": [
      {
        "title": "OkulDesk - Okul Yönetim Otomasyonu",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico"
    ]
  }
}
